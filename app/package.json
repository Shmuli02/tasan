{
  "name": "equal-care-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-data.mjs && python3 ../data/scripts/check_facts.py",
    "dev": "npm run sync && vite",
    "build": "npm run sync && tsc --noEmit && vite build && node scripts/strip-personal-names.mjs --check dist",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "node scripts/smoke.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "deploy": "bash scripts/deploy.sh",
    "build:offline": "vite build --config vite.offline.config.ts && node scripts/pack-offline.mjs && node scripts/strip-personal-names.mjs --check dist-offline",
    "screenshot:offline": "node scripts/screenshot-offline.mjs",
    "stage": "npm run build && python3 -m http.server 8080 --bind 127.0.0.1 --directory dist",
    "check:facts": "python3 ../data/scripts/check_facts.py",
    "check:answers": "node scripts/check_answer_numbers.mjs",
    "check:names": "node scripts/strip-personal-names.mjs --check dist"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
