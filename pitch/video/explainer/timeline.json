  "voice": [
    {"file": "v1.wav", "at": 1.2,  "text": ["This is a spirit level.", "When things are even, the bubble sits right in the middle."]},
    {"file": "v2.wav", "at": 7.6,  "text": ["But lung cancer care in Finland isn’t level.", "Same cancer, different postcode."]},
    {"file": "v3.wav", "at": 14.0, "text": ["About 65 more lung cancer patients a year would get curative treatment,", "if every below-average county reached the national rate.", "About 12 of them are in Lapland."]},
    {"file": "v4.wav", "at": 25.6, "text": ["The trouble is, no county can see the clock.", "Nobody publishes whether patients start treatment in time."]},
    {"file": "v5.wav", "at": 33.4, "text": ["Tasan starts a clock the day the referral arrives.", "No treatment decision by day 28?", "The nurse navigator gets an alert, and takes it from there."]},
    {"file": "v6.wav", "at": 45.4, "text": ["The pilot is ninety days, one clock, and one nurse.", "Lapland could start on Monday."]},
    {"file": "v7.wav", "at": 54.6, "text": ["Tasan — koska hoito ei saa riippua postinumerosta."]}
